{
  "name": "@mobiscroll/connect-sdk",
  "version": "1.5.0",
  "description": "Node.js client for Mobiscroll Connect, the calendar connectivity layer for scheduling products — Google Calendar, Microsoft Outlook, Apple Calendar and CalDAV through one API.",
  "homepage": "https://mobiscroll.com/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acidb/mobiscroll-connect-sdks.git",
    "directory": "sdks/node"
  },
  "bugs": {
    "url": "https://github.com/acidb/mobiscroll-connect-sdks/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prerelease": "bash ./pre-release.sh",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "mobiscroll",
    "calendar-api",
    "calendar-connectivity",
    "google-calendar",
    "outlook-calendar",
    "apple-calendar",
    "caldav",
    "oauth2",
    "calendar-sync",
    "scheduling"
  ],
  "author": "Mobiscroll",
  "license": "MIT",
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "node-ical": "^0.23.1",
    "prettier": "^3.0.3",
    "tsdav": "^2.1.6",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
