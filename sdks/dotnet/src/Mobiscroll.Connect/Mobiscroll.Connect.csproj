<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mobiscroll.Connect</RootNamespace>
    <AssemblyName>Mobiscroll.Connect</AssemblyName>

    <PackageId>Mobiscroll.Connect</PackageId>
    <Version>1.5.0</Version>
    <Authors>Mobiscroll</Authors>
    <Company>Mobiscroll</Company>
    <Description>.NET client for Mobiscroll Connect, the calendar connectivity layer for scheduling products. Google Calendar, Microsoft Outlook, Apple Calendar and CalDAV through one async API. Backend only — works with your own UI.</Description>
    <PackageTags>mobiscroll;calendar-api;calendar-connectivity;google-calendar;outlook-calendar;apple-calendar;caldav;oauth2;calendar-sync;scheduling</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://mobiscroll.com/connect</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/acidb/mobiscroll-connect-sdks/blob/main/sdks/dotnet/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/acidb/mobiscroll-connect-sdks.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

</Project>
