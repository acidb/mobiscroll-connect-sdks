{
  "name": "mobiscroll/connect-php",
  "description": "PHP client for Mobiscroll Connect, the calendar connectivity layer for scheduling products — Google Calendar, Microsoft Outlook, Apple Calendar and CalDAV through one API.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://mobiscroll.com/connect",
  "keywords": [
    "mobiscroll",
    "calendar-api",
    "calendar-connectivity",
    "google-calendar",
    "outlook-calendar",
    "apple-calendar",
    "caldav",
    "oauth2",
    "calendar-sync",
    "scheduling"
  ],
  "authors": [
    {
      "name": "Mobiscroll",
      "email": "support@mobiscroll.com"
    }
  ],
  "support": {
    "issues": "https://github.com/acidb/mobiscroll-connect-sdks/issues",
    "source": "https://github.com/acidb/mobiscroll-connect-sdks/tree/main/sdks/php",
    "docs": "https://mobiscroll.com/docs/connect/php-sdk"
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.5",
    "guzzlehttp/promises": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Mobiscroll\\Connect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mobiscroll\\Connect\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:watch": "phpunit --watch",
    "stan": "phpstan analyse src",
    "lint": "phpstan analyse src tests --level=8"
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpunit/phpunit": true
    }
  }
}
